<component type="desktop-application">
  <id>io.github.ulinaaron.rivet-files</id>
  <name>Rivet Files</name>
  <summary>Classic Linux file manager</summary>
  <developer id="io.github.ulinaaron">
    <name>ulinaaron</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
